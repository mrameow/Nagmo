<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/item_color"
            android:layout_width="6dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_color_bar" />

        <ImageView
            android:id="@+id/item_check"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_mark_done"
            android:padding="9dp"
            android:src="@drawable/ic_widget_check" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/nagmo_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/nagmo_ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/item_pin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_pin"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/item_priority"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_priority"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
